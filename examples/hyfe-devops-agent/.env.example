# Z.AI API Key (coding plan endpoint)
ZAI_API_KEY=your-zai-api-key-here

# Self-hosted Langfuse tracing
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=http://localhost:3000

# Enable LangChain tracing (auto-detects Langfuse env vars)
LANGCHAIN_TRACING_V2=true

# GitHub personal access token for GitHub Projects v2 GraphQL API.
# Required scopes: repo, project
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Default GitHub Projects v2 board number
GITHUB_PROJECT_NUMBER=12

# Default GitHub organization login for board operations
GITHUB_ORG=your-github-org

# Default GitHub repository name for ticket operations
GITHUB_REPO=your-github-repo

# Slack bot token for Web API calls (notifications and emoji-based voting).
# Required scopes: chat:write, reactions:write, reactions:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Optional default Slack channel for notifications and votes (e.g. #devops)
SLACK_DEFAULT_CHANNEL=#devops

# Advisory WIP limit defaults for board tools (warning, not hard block)
BOARD_MAX_IN_SCOPE=10
BOARD_MAX_IN_PROGRESS=3
